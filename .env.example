# Creem digital credit checkout
# Use test credentials and test product IDs until end-to-end validation passes.
CREEM_ENVIRONMENT=test
CREEM_API_KEY=
# Required for every user-supplied AI prompt. In production, use a live key;
# sandbox moderation does not satisfy Creem's account-review requirement.
CREEM_MODERATION_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_STARTER_PRODUCT_ID=
CREEM_PRO_PRODUCT_ID=
CREEM_MASTER_PRODUCT_ID=

# Public origin used for Creem's signed success redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
